---
import Monitor from '../layouts/Monitor.astro';
import { buildStore } from '../lib/store';

const store = await buildStore();
const { host, user } = store.site;
// Percorsi delle cartelle, per tornare alla più vicina (lo script inline non può importare `nearestDir`).
const dirs = JSON.stringify([...store.nodes.values()].filter((n) => n.type === 'dir').map((n) => n.path)).replace(/</g, '\\u003c');
---
<Monitor
  title={`Non trovato · ${host}`}
  description={`Percorso inesistente su ${host}.`}
  canonical="/404"
  ogPath="/og/home.png"
  page="404"
  noindex
>
  <pre class="term"><span class="dim">{user}@{host} ~ $ </span>cat <span id="missing-path">questo percorso</span>
cat: <span id="missing-path-err">questo percorso</span>: file o cartella inesistente
Prova <a id="back" href="/">ls /</a></pre>
  <script is:inline type="application/json" id="dirs" set:html={dirs}></script>
  <script is:inline>
    (function () {
      var p = location.pathname;
      // Stesso giro di `nearestDir` in fs-tree.ts: il primo antenato che è una cartella, altrimenti la radice.
      var dirs = JSON.parse(document.getElementById('dirs').textContent || '[]');
      var parts = p.split('/').filter(Boolean);
      var back = '/';
      for (var i = parts.length - 1; i > 0; i--) {
        var d = parts.slice(0, i).join('/');
        if (dirs.indexOf(d) !== -1) {
          back = '/' + d;
          break;
        }
      }
      document.getElementById('missing-path').textContent = p;
      document.getElementById('missing-path-err').textContent = p;
      var a = document.getElementById('back');
      a.setAttribute('href', back);
      a.textContent = 'ls ' + back;
    })();
  </script>
</Monitor>
