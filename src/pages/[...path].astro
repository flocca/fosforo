---
import Monitor from '../layouts/Monitor.astro';
import { buildStore } from '../lib/store';
import { findByPath } from '../lib/fs-tree';
import { renderPath } from '../lib/render';
import { level0Html, promptCommand } from '../lib/level0';
import { pageMeta, pageNodes } from '../lib/static-paths';

export async function getStaticPaths() {
  const store = await buildStore();
  return pageNodes(store)
    .filter((n) => n.path !== '')
    .map((n) => ({ params: { path: n.path } }));
}

const store = await buildStore();
const path = Astro.params.path as string;
const meta = pageMeta(path, store)!;
const { host, user } = store.site;
const isDir = findByPath(store.root, path)?.type === 'dir';
const html = level0Html(
  [{ text: `${user}@${host} ~ $ `, style: 'dim' }, { text: promptCommand(path, isDir) }],
  renderPath(path, store) ?? [],
);
---
<Monitor {...meta} path={path}>
  <pre class="term" set:html={html} />
</Monitor>
