---
// Pagina del terminale: HTML di livello 0 con tutti i meta per i crawler.
import '@fontsource/fira-mono/latin-400.css';
import '@fontsource/fira-mono/latin-ext-400.css';
import '@fontsource/fira-mono/symbols2-400.css';
import '@fontsource/fira-mono/latin-700.css';
import '@fontsource/fira-mono/latin-ext-700.css';
import '@fontsource/fira-mono/symbols2-700.css';
import '../styles/crt.css';
import { buildStore } from '../lib/store';

type Props = {
  title: string;
  description: string;
  canonical: string; // percorso con barra iniziale
  ogPath: string;
  page: 'home' | 'item' | '404';
  path?: string;
  aliasTarget?: string;
  noindex?: boolean;
};

const { title, description, canonical, ogPath, page, path, aliasTarget, noindex } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).href;
// Targhetta del monitor: la prima riga della ROM fino al primo doppio spazio ("FOSFORO VT-78").
const { site } = await buildStore();
const label = (site.boot.rom[0]?.text ?? site.host).split(/\s{2,}/)[0].trim().toUpperCase();
---
<!doctype html>
<html lang="it" data-fosfori="verde">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(canonical)} />
    <meta property="og:image" content={abs(ogPath)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Fosfori scelti dal visitatore, prima del primo disegno (senza storage: verde).
      (function () {
        try {
          var v = localStorage.getItem('fosforo.fosfori');
          if (v === 'verde' || v === 'ambra' || v === 'bianco') document.documentElement.dataset.fosfori = v;
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-page={page} data-path={path} data-alias-target={aliasTarget}>
    <div class="monitor">
      <div class="screen-well">
        <div class="screen">
          <main id="screen"><slot /></main>
          <div class="chips" hidden></div>
          <div class="screen-off" aria-hidden="true"></div>
          <div class="screen-glass" aria-hidden="true"></div>
        </div>
      </div>
      <div class="monitor-panel">
        <span class="monitor-label" aria-hidden="true">{label}</span>
        <span class="sound-indicator">suono: acceso</span>
        <span class="led is-on" aria-hidden="true"></span>
        <button type="button" class="power-button" aria-label="Accendi"></button>
      </div>
    </div>
  </body>
</html>
